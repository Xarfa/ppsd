# 配置模板 —— 复制成 .env 再改
#   cp .env.example .env

# 数据库驱动
#   pg      连真正的 PostgreSQL 服务器（推荐，学校服务器上就是这个）
#   pglite  npm 装的 PostgreSQL/WASM 版，零安装，本机没装 PG 时用
PPSD_DB_DRIVER=pg

# 驱动 = pg 时的连接串
#   格式 postgres://<用户>:<密码>@<主机>:<端口>/<库名>
DATABASE_URL=postgres://postgres@127.0.0.1:5432/ppsd

# 驱动 = pglite 时的数据目录（默认 %LOCALAPPDATA%\ppsd\pgdata）
# 注意：PGlite 在本机 E: 盘会报错，别指到 E 盘
# PGLITE_DIR=

# HTTP 端口
PORT=3000

# ---------------------------------------------------------------------------
# BLAST
# ---------------------------------------------------------------------------
# 引擎：auto（有 NCBI 就用 NCBI，否则 JS）/ ncbi / js
PPSD_BLAST_ENGINE=auto

# 老站 BLAST 目录（里面有 ncbi-blast-2.9.0+/bin/blastn 和 db/）
# 不填时自动探测：服务器 /home/www/html/PPSD_zby/blast，本地 data/reference/PPSD_zby/blast
# PPSD_BLAST_DIR=/home/www/html/PPSD_zby/blast

# 单独覆盖二进制 / 库目录（一般不用填）
# PPSD_BLAST_BIN=
# PPSD_BLAST_DB_DIR=

# 单次 BLAST 超时（毫秒）
# PPSD_BLAST_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# 老站静态资产（不拷进 dist，直接只读引用）
# ---------------------------------------------------------------------------
# tplot 图片目录。不填时自动探测服务器老目录或本地 data/reference 拷贝
# PPSD_TPOT_DIR=/home/www/html/PPSD_zby/tplot

# JBrowse 静态实例目录（仅水稻 chr11）。不填时自动探测
# PPSD_JBROWSE_DIR=/home/www/html/PPSD_zby/JBrowse/jbrowse
